# Copie com npm run setup. Configuracao privada: ../.local/.env
MCP_AUTH_TOKEN=GENERATE_WITH_SETUP
PROJECT_DIRECTORY=D:\Projetos\meu-projeto
ALLOWED_DIRECTORIES=D:\Projetos\meu-projeto
ENABLED_MCPS=devtools,filesystem,ssh,terminal,serena,context7
PROXY_PORT=8006
MCP_BASE_PORT=8016
CHROME_PORT=9222

# Vazio: tunel temporario. Nomeado: hostname + token, destino http://127.0.0.1:8006
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_HOSTNAME=
NO_TUNNEL=0
DEBUG_MCP=0

# SSH usa o OpenSSH e as chaves do usuario; nao exponha chaves pelo Filesystem.
SSH_KEYS_DIR=
DEFAULT_SSH_USER=
DEFAULT_SSH_HOST=
DEFAULT_SSH_KEY=
DEFAULT_WSL_DISTRO=

# Execute npm run setup:serena. Caminho completo se serena nao estiver no PATH.
SERENA_COMMAND=serena
# Opcional conforme autenticacao/limites do Context7; nunca publique a chave.
CONTEXT7_API_KEY=
# Opcional: adicione github a ENABLED_MCPS. Alternativa: OAuth direto, veja docs.
GITHUB_PERSONAL_ACCESS_TOKEN=
